{
  "name": "nayan.fun",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "dev:nayan:web": "turbo run dev --filter=@nayan-fun/web",
    "dev:studio:studio": "turbo run dev --filter=@nayan-fun/studio",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "generate": "turbo run generate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
